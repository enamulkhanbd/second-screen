# ==============================================================================
# Tokens Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or configure these
# environment variables in your production deployment hosting (Vercel / Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Cloud Firestore (Optional / Recommended)
# ------------------------------------------------------------------------------
# Leave empty to use standalone secure client-side storage mode.
# When provided, enables multi-user cloud synchronization and team collaboration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Application & API Security Settings
# ------------------------------------------------------------------------------
# Base URL for public API endpoints and invitation redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key used for signing session tokens and API keys (Generate with `openssl rand -hex 32`)
TOKENS_PLATFORM_SECRET_KEY=

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production
