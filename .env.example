# ==============================================================================
# Tokens Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or configure these
# environment variables in your production deployment hosting (Vercel / Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & PostgreSQL Database
# ------------------------------------------------------------------------------
# Self-hosted / Cloud Supabase URL & Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key for server-side admin APIs and migrations (Keep Secret!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Application & API Security Settings
# ------------------------------------------------------------------------------
# Base URL for public API endpoints and invitation redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key used for signing session tokens and API keys (Generate with `openssl rand -hex 32`)
TOKENS_PLATFORM_SECRET_KEY=

# Invitation emails via Resend (https://resend.com). Optional: without these,
# admins share the invite link manually.
RESEND_API_KEY=
INVITE_FROM_EMAIL=Tokens Platform <invites@your-verified-domain.com>

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (Asset CDN)
# ------------------------------------------------------------------------------
# S3-compatible object storage for project assets (SVGs, images, documents).
# Free tier: 10 GB storage, 10M reads/mo, 1M writes/mo, zero egress fees.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=second-screen-assets
R2_PUBLIC_URL=
