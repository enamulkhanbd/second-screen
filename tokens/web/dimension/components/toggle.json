    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "{units.x32}",
        "$description": "Toggle small height (32px)"
      },
      "md": {
        "$type": "dimension",
        "$value": "{units.x40}",
        "$description": "Toggle medium height (40px)"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{units.x48}",
        "$description": "Toggle large height (48px)"
      }
    },
    "padding-x": {
      "sm": {
        "$type": "dimension",
        "$value": "{padding.sm}",
        "$description": "Toggle horizontal padding small (12px)"
      },
      "md": {
        "$type": "dimension",
        "$value": "{padding.md}",
        "$description": "Toggle horizontal padding medium (16px)"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{padding.lg}",
        "$description": "Toggle horizontal padding large (24px)"
      }
    },
    "padding-y": {
      "sm": {
        "$type": "dimension",
        "$value": "{padding.xs}",
        "$description": "Toggle vertical padding small (8px)"
      },
      "md": {
        "$type": "dimension",
        "$value": "{padding.sm}",
        "$description": "Toggle vertical padding medium (12px)"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{padding.md}",
        "$description": "Toggle vertical padding large (16px)"
