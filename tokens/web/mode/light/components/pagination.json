        "$description": "Pagination button focus ring outline."
      },
      "border": {
        "$type": "boxShadow",
        "$value": "{focus-ring.border}",
        "$description": "Pagination button focus ring border."
      }
    },
    "selected": {
      "bg": {
        "$type": "color",
        "$value": "{interaction.primary.default}",
        "$description": "Selected page button background fill."
      },
      "text": {
        "$type": "color",
        "$value": "{base.50}",
        "$description": "Selected page button text color."
      },
      "border": {
        "$type": "color",
        "$value": "{interaction.primary.default}",
        "$description": "Selected page button border color."
      }
    },
    "bg": {
      "default": {
        "$type": "color",
        "$value": "{bg.default}",
        "$description": "Pagination background color — default state."
