        "$type": "color",
        "$value": "{neutral.300}",
        "$description": "Pagination border color — disabled state."
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{text.body}",
        "$description": "Pagination foreground text color — default state."
