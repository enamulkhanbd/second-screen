{
  "popover": {
    "surface": {
      "$type": "color",
      "$value": "{elevation.surface.level3}",
      "$description": "Popover surface container color."
    },
    "shadow": {
      "$type": "boxShadow",
      "$value": "{shadow.floating.sm}",
      "$description": "Popover floating elevation shadow."
    },
    "layer": {
      "$type": "number",
