      "hover": {
        "$type": "color",
        "$value": "{bg.raised}",
        "$description": "Popover background color — hover state."
      },
      "active": {
        "$type": "color",
        "$value": "{bg.focus}",
        "$description": "Popover background color — active state."
      },
      "disabled": {
        "$type": "color",
        "$value": "{neutral.100}",
        "$description": "Popover background color — disabled state."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{border.default}",
        "$description": "Popover border color — default state."
      },
      "focus": {
        "$type": "color",
        "$value": "{border.focus}",
        "$description": "Popover border color — focus state."
      },
      "disabled": {
        "$type": "color",
        "$value": "{neutral.300}",
        "$description": "Popover border color — disabled state."
