{
  "dropdown": {
    "surface": {
      "$type": "color",
      "$value": "{elevation.surface.level2}",
      "$description": "Dropdown floating menu surface color — dark floating surface."
    },
    "shadow": {
      "$type": "boxShadow",
      "$value": "{shadow.floating.sm}",
      "$description": "Dropdown floating elevation shadow."
    },
    "layer": {
      "$type": "number",
      "$value": "{layer.dropdown}",
      "$description": "Dropdown menu z-index layer."
    },
    "bg": {
      "default": {
        "$type": "color",
        "$value": "{neutral.900}",
        "$description": "Dropdown background color — default state."
      },
      "hover": {
        "$type": "color",
        "$value": "{neutral.800}",
        "$description": "Dropdown background color — hover state."
      },
      "active": {
        "$type": "color",
        "$value": "{neutral.700}",
        "$description": "Dropdown background color — active state."
      },
      "disabled": {
        "$type": "color",
        "$value": "{neutral.900}",
        "$description": "Dropdown background color — disabled state."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{neutral.700}",
        "$description": "Dropdown border color — default state."
      },
      "focus": {
        "$type": "color",
        "$value": "{primary.500}",
        "$description": "Dropdown border color — focus state."
      },
      "disabled": {
        "$type": "color",
        "$value": "{neutral.800}",
        "$description": "Dropdown border color — disabled state."
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{neutral.100}",
        "$description": "Dropdown foreground text color — default state."
      },
      "muted": {
        "$type": "color",
        "$value": "{neutral.400}",
        "$description": "Dropdown secondary text color — muted state."
      },
      "disabled": {
        "$type": "color",
        "$value": "{neutral.600}",
        "$description": "Dropdown text color — disabled state."
      }
    }
  }
}