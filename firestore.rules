rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Pairing Sessions (Handshake for Figma Companion Plugin)
    match /pairing_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 2. Personal Access Tokens (PAT Authentication)
    // Stores SHA-256 hashed API keys and metadata
    match /api_keys/{keyId} {
      allow read, write: if true;
    }

    // 3. Organizations & Multi-Tenant Projects
    match /organizations/{orgId} {
      allow read, write: if true;

      // Projects subcollection under organization (Tokens, Themes, Figma variables)
      match /projects/{projectId} {
        allow read, write: if true;
      }
    }

    // 4. Team Invitations
    match /invitations/{invitationId} {
      allow read, write: if true;
    }

    // 5. Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
