rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Pairing Sessions (Temporary 6-digit handshake for Figma Plugin pairing)
    match /pairing_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 2. Personal API Tokens (PATs used by CLI / Figma Plugin Bridge)
    match /api_keys/{keyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Organizations and Multi-Tenant Project Documents
    match /organizations/{orgId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;

      match /projects/{projectId} {
        allow read, write: if request.auth != null;
      }
    }

    // 4. Team Invitations
    match /invitations/{invitationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Default Secure Fallback for all other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
