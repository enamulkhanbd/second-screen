{
  "rules": [
    {
      "allowed": {
        "origins": [
          "*"
        ],
        "methods": [
          "GET",
          "PUT",
          "POST",
          "DELETE",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposed": {
        "headers": [
          "ETag",
          "Content-Type"
        ]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
